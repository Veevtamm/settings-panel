{
  "name": "@veevtamm/settings-panel",
  "version": "0.2.0",
  "private": true,
  "description": "Scene settings panel for Next.js + Tailwind 4 sites",
  "license": "MIT",
  "homepage": "https://github.com/Veevtamm/settings-panel",
  "bugs": {
    "url": "https://github.com/Veevtamm/settings-panel/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Veevtamm/settings-panel.git"
  },
  "keywords": [
    "react",
    "nextjs",
    "tailwindcss",
    "settings",
    "panel"
  ],
  "type": "module",
  "portless": {
    "name": "settings-panel",
    "script": "playground:app"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "check": "tsc --noEmit -p . && vitest run",
    "playground": "portless",
    "playground:app": "vite playground",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./utils": "./src/lib/utils.ts",
    "./cubic-bezier": "./src/lib/cubic-bezier.ts",
    "./easing-presets": "./src/lib/easing-presets.ts",
    "./hex": "./src/lib/hex.ts",
    "./prefers-reduced-motion": "./src/lib/prefers-reduced-motion.ts",
    "./use-local-settings-store": "./src/lib/use-local-settings-store.ts",
    "./param-store": "./src/lib/param-store.ts",
    "./is-over-settings-panel": "./src/lib/is-over-settings-panel.ts",
    "./frame-orient": "./src/lib/frame-orient.ts",
    "./skip-cells": "./src/lib/skip-cells.ts",
    "./eval-number-expression": "./src/lib/eval-number-expression.ts",
    "./panel-theme": "./src/lib/panel-theme.ts",
    "./copy-text": "./src/lib/copy-text.ts",
    "./transition-player": "./src/lib/transition-player.ts",
    "./scroll-player": "./src/lib/scroll-player.ts",
    "./playhead": "./src/lib/playhead.ts",
    "./player-clips": "./src/lib/player-clips.ts",
    "./sf-symbol": "./src/sf-symbol.tsx",
    "./easing-curve-editor": "./src/easing-curve-editor.tsx",
    "./axis-curve": "./src/lib/axis-curve.ts",
    "./axis-curve-editor": "./src/axis-curve-editor.tsx"
  },
  "files": [
    "src",
    "AGENTS.md",
    "CHANGELOG.md",
    ".cursor/rules/settings-panel.mdc"
  ],
  "peerDependencies": {
    "clsx": "^2",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
